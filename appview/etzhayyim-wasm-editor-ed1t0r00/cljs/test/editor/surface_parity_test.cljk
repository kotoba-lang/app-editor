(ns editor.surface-parity-test
  "aiueos/editor_surface.cljk（判定コア）と app.cljk の宣言 x wrangler.jsonc
  の整合の parity。宣言（default-db）が実設定と一致することを実データで照合。
  scaffold の stale 値ではなく wrangler 由来であることもここで固定する。"
  (:require [clojure.test :refer [deftest is testing]]
            [clojure.string :as str]
            ["fs" :as fs]))

(def default-db
  ;; app.cljk の default-db（field for field）
  {:title "Editor Mcp Component"
   :project "etzhayyim-project-editor"
   :name "etzhayyim-wasm-editor-ed1t0r00"
   :kind "appview"
   :route-count 2
   :routes ["ed1t0r00.etzhayyim.com/*" "editor.etzhayyim.com/*"]
   :vars ["AGENTGATEWAY_MCP_ROUTER_URL" "APP_CAPABILITIES" "APP_DESCRIPTION"
          "APP_DISPLAY_NAME" "APP_FRAMEWORK" "APP_NANOID" "APP_PERFORMER_TYPE"
          "APP_UI_TYPE"]
   :xrpc? true
   :relative-path "appview/etzhayyim-wasm-editor-ed1t0r00/cljs/src/editor/app.cljk"})

(def wrangler-raw
  (fs/readFileSync
   (str/join "/" ["appview" "etzhayyim-wasm-editor-ed1t0r00" "wrangler.jsonc"]) "utf8"))

;; jsonc: 行コメントを落として JSON として読む
(def wrangler
  (js->clj (js/JSON.parse (str/replace wrangler-raw #"(?m)^\s*//.*$" "")) :keywordize-keys true))

(deftest declaration-matches-wrangler
  (testing "guest test-count: route-count は wrangler のルート数と一致"
    (is (= (:route-count default-db) (count (:routes default-db)))))
  (testing "guest test-vars: vars は wrangler の vars キーと一致"
    (is (= (set (:vars default-db)) (set (map name (keys (:vars wrangler)))))))
  (testing "guest test-surface: source path の明示"
    (is (string? (:relative-path default-db)))))
