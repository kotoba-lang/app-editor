{
  "name": "kotodama-ed1t0r00",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"code-editor\",\"project-management\",\"llm-codegen\",\"sandbox-preview\"]",
    "APP_DESCRIPTION": "Web code editor + project manager — CodeMirror 6 + Sandpack preview, v0-style LLM gen",
    "APP_DISPLAY_NAME": "Editor",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "APP_NANOID": "ed1t0r00",
    "APP_PERFORMER_TYPE": "service",
    "APP_UI_TYPE": "yoro",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "ed1t0r00.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    },
    {
      "pattern": "editor.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
